 

      <#
Script PowerShell
Diag Windows – Arrêts et erreurs
Date : 2026-06-05 
Autor : GRUBER Nicolas 
#>
cls
# === Informations système ===
$fqdn = [System.Net.Dns]::GetHostByName(($env:COMPUTERNAME)).HostName
$lastboot = (Get-CimInstance Win32_OperatingSystem).LastBootUpTime
$ips  = (Get-NetIPAddress -AddressFamily IPv4 -ErrorAction SilentlyContinue |
         Where-Object { $_.IPAddress -notlike '169.*' -and $_.IPAddress -ne '127.0.0.1' }).IPAddress

Write-Host "=== Diagnostic sur $fqdn ===" -ForegroundColor Cyan
Write-Host "Adresse(s) IP : $($ips -join ', ')" -ForegroundColor Cyan
Write-Host "Serveur Up depuis : "-ForegroundColor Cyan  $lastboot 

Write-Host ""


# ====================================================================
# QD - Arrêts et démarrages système
# ====================================================================
Write-Host "`n=== Arrêts et démarrages système ===" -ForegroundColor Cyan

Get-WinEvent -FilterHashtable @{
    LogName = 'System'
    Id      = 12,13,41,1074,6005,6006,6008,6013
} -MaxEvents 100 |
Sort-Object TimeCreated -Descending |
Select-Object -First 10 |
ForEach-Object {

    $event = $_

    switch ($event.Id) {
        12   { $type = "Démarrage OS confirmé (Kernel-General)" }
        13   { $type = "Arrêt OS confirmé (Kernel-General)" }
        6005 { $type = "Démarrage du service EventLog / boot Windows" }
        6006 { $type = "Arrêt normal du service EventLog" }
        6008 { $type = "Arrêt inattendu précédent" }
        6013 { $type = "Uptime système" }
        1074 { $type = "Arrêt/redémarrage initié proprement" }
        41   { $type = "Arrêt brutal Kernel-Power" }
        default { $type = "Autre" }
    }

    Write-Host ("{0:yyyy-MM-dd HH:mm:ss} [ID {1}] {2}" -f $event.TimeCreated, $event.Id, $type) -ForegroundColor Yellow

    # Message Windows complet, utile surtout pour 6013 / 6005 / 6006
    if ($event.Message) {
        Write-Host ("   Message : {0}" -f ($event.Message -replace "`r?`n", "`n             ")) -ForegroundColor DarkYellow
    }

    # Détails XML quand disponibles
    try {
        $xml = [xml]$event.ToXml()

        if ($xml.Event.EventData.Data) {
            foreach ($d in $xml.Event.EventData.Data) {
                if ($d.Name -and $d.'#text') {
                    Write-Host ("   {0} : {1}" -f $d.Name, $d.'#text') -ForegroundColor DarkGray
                }
                elseif ($d.Name) {
                    Write-Host ("   {0} : <vide>" -f $d.Name) -ForegroundColor DarkGray
                }
                elseif ($d.'#text') {
                    Write-Host ("   Data : {0}" -f $d.'#text') -ForegroundColor DarkGray
                }
            }
        }
    }
    catch {
        Write-Host "   Impossible de lire les détails XML." -ForegroundColor DarkGray
    }

    Write-Host ""
}

pause

# === 10 dernières erreurs/critiques ===
Write-Host "`n=== 10 dernières erreurs/critiques ===" -ForegroundColor Cyan
$errors = Get-WinEvent -LogName System -MaxEvents 2000 |
           Where-Object { $_.Level -in 1,2 } |
          Sort-Object TimeCreated -Descending |
          Select-Object -First 10

foreach ($e in $errors) {
    Write-Host ("{0:yyyy-MM-dd HH:mm:ss} [ID {1}] {2}" -f $e.TimeCreated, $e.Id, $e.ProviderName) -ForegroundColor Yellow
    Write-Host ("   {0}" -f $e.Message) -ForegroundColor DarkYellow
    Write-Host ""
}








