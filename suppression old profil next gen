# BLOC2 -------------------------------------- VARIABLES INTERNES / FUNCTIONS ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

$ComputerName = $env:COMPUTERNAME


function Write-Log { #créer un fonction de write-log pour CMTrace
    param (
        [string]$Message,
        [string]$Level = "INFO"
    )
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $line = "$timestamp [$Level] - $Message"
    [System.IO.File]::AppendAllText($LogPath, $line + [Environment]::NewLine, [System.Text.Encoding]::UTF8)
}

function Convert-ProfileLoadTime { # fonction d'assemblage des HIGH et LOW dans le profil list pour déterminer la DATE de la dernière connexion
    param (
        [UInt32]$High,
        [UInt32]$Low    )
    $fileTime = ([Int64]$High -shl 32) -bor ([UInt32]$Low)
    if ($fileTime -le 0) { return $null    }
    return [DateTime]::FromFileTime($fileTime)
}

function Get-ProfileAgeText { # créer un valeur en jour de la dernière ouverture de session 
    param (   [Nullable[DateTime]]$LastLoadTime    )
    if (-not $LastLoadTime) {    return "Aucune valeur"   }
    $days = [math]::Floor(((Get-Date) - $LastLoadTime).TotalDays)
    return "$($LastLoadTime.ToString("yyyy-MM-dd HH:mm:ss")) / ($days jours)"
}

function Test-ProtectedOrphanFolder { 
    param (
        [string]$FolderName,
        [string[]]$ProtectedPatterns
    )

    foreach ($pattern in $ProtectedPatterns) {
        if ($FolderName -like $pattern) {
            return $true
        }
    }
    return $false
}

function Test-SystemProfile {  # lister les profils système
    param (
        [string]$Account
    )

    if ($Account -like "AUTORITE NT\*" -or
        $Account -like "NT AUTHORITY\*" -or
        $Account -like "NT SERVICE\*" -or
        $Account -like "Window Manager\*" -or
        $Account -like "Font Driver Host\*" -or
        $Account -like "UMFD-*" -or
        $Account -like "DWM-*") {
        return $true
    }
    return $false
}

function Get-ProfileAccountType { #récupérer le type de compte - AD / spécial / inconu / local
    param (
        [string]$Account,
        [string]$ProfilePath,
        [string]$ComputerName
    )
    if ($Account -eq "SID_NON_RESOLU") {     return "UNKNOWN" }
    if (Test-SystemProfile -Account $Account) { return "SYSTEM" }
    if ($Account -like "$ComputerName\*") {     return "LOCAL"    }
    if ($Account -like "AzureAD\*") {    return "CLOUD"}
    if ($Account -like "MicrosoftAccount\*") {    return "CLOUD" }
    if ($Account -match '^[^\\]+\\[^\\]+$') {      return "DOMAIN"   }
    return "UNKNOWN"
}

function Test-ProtectedProfile { #exlcusion des profils définit
    param (
        [string]$ProfileDir,
        [string]$Account,
        [string[]]$ProtectedPatterns
    )
    foreach ($pattern in $ProtectedPatterns) {
        if ($ProfileDir -like $pattern) {      return $true      }
        if ($Account -like $pattern) {        return $true        }
    }
    return $false
}

function Get-ProfileSizeMB { #calculer taille folder avec limitation de temps par test
    param (
        [string]$Path,
        [int]$MaxSeconds    )
        $stopWatch = [System.Diagnostics.Stopwatch]::StartNew()
        $totalSize = 0
    try { Get-ChildItem $Path -Recurse -Force -File -ErrorAction SilentlyContinue | ForEach-Object {
            $totalSize += $_.Length
            if ($stopWatch.Elapsed.TotalSeconds -ge $MaxSeconds) {
                throw "TIMEOUT"      }   }
        return [math]::Round($totalSize / 1MB, 2)    }
        catch {     return [math]::Round($totalSize / 1MB, 2)   }
    }

