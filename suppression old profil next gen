    else { Write-Log "Le script doit être exécuté avec des privilèges administrateur pour effectuer des suppressions - arrêt du script" "ERROR"
        exit 1 } }

if ($warningagedays) { Write-Log "Valeur ProfileAgeDays trop basse - seuil minimum de sécurité appliqué automatiquement : 7 jours" "WARNING"  }

#Garde-fou si on démarre sur un serveur = SIMLULATION - bypassable en forçant la commande 
$IsServer = (Get-CimInstance Win32_OperatingSystem).ProductType -ne 1
if ($IsServer -and -not $BypassServerProtection) {
    $SimulationMode = $true
    Write-Log "Serveur Windows détecté : simulation forcée" "ERROR"
}



# BLOC3 -------------------------------------- RECHERCHE PROFILS + FILTRAGE LOCALPROFILELOADTIME ------------------------------------------------------------------------------------------------------------------------------------------------------------

Write-Log "------------------------------------------------------------------------------------------------------------------ START script ------------------------------------------------------------------------------------------------------------------"

Write-log "---------START Paramètre script---------" 
Write-Log "Machine locale : $ComputerName"
Write-Log "Seuil d'inactivité profil local : $ProfileAgeDays jours"
Write-Log "Mode simulation : $SimulationMode"
Write-Log "Suppression profils locaux activée : $DeleteLocalProfiles"
Write-Log "Suppression Dossiers orphelins : $CleanOrphanProfiles"
Write-Log "Calcul tailles des dossiers activé : $CalculateProfileSize"

$ProfileRegPath = "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\ProfileList"
$CutoffDate = (Get-Date).AddDays(-$ProfileAgeDays)

Write-Log "Date limite : $($CutoffDate.ToString("yyyy-MM-dd HH:mm:ss"))"
Write-Log "Profils protégés personnalisés : $($ProtectedProfiles -join ', ')"
if ($CalculateProfileSize) { Write-Log "Calcul taille profil activé : max $MaxSeconds secondes par profil - résultat approximatif" "WARNING" }
Write-log "---------END Paramètre---------" 

#--------------------------------- Recherche profil dans le registre --------------------------------
$AllProfiles = Get-ChildItem $ProfileRegPath -ErrorAction SilentlyContinue | ForEach-Object {

    $sid = $_.PSChildName
    $profile = Get-ItemProperty $_.PSPath -ErrorAction SilentlyContinue

    if (-not $profile.ProfileImagePath) {
        return
    }

    try {
        $account = ([System.Security.Principal.SecurityIdentifier]$sid).
            Translate([System.Security.Principal.NTAccount]).Value
    }
    catch {
        $account = "SID_NON_RESOLU"
    }

    $lastLoadTime = $null

    if ($null -ne $profile.LocalProfileLoadTimeHigh -and $null -ne $profile.LocalProfileLoadTimeLow) {
        $lastLoadTime = Convert-ProfileLoadTime `
            -High ([UInt32]$profile.LocalProfileLoadTimeHigh) `
            -Low ([UInt32]$profile.LocalProfileLoadTimeLow)
    }

    $profileDir = Split-Path $profile.ProfileImagePath -Leaf

    $accountType = Get-ProfileAccountType `
        -Account $account `
        -ProfilePath $profile.ProfileImagePath `
        -ComputerName $ComputerName

    if ($CalculateProfileSize) {
        $profileSizeMB = Get-ProfileSizeMB `
            -Path $profile.ProfileImagePath `
            -MaxSeconds $MaxSeconds
    }
    else {
        $profileSizeMB = $null
    }

    [PSCustomObject]@{
        Sid           = $sid
        Account       = $account
        AccountType   = $accountType
        ProfileDir    = $profileDir
        Path          = $profile.ProfileImagePath
        LastLoadTime  = $lastLoadTime
        ProfileSizeMB = $profileSizeMB
    }
}

# Analyse dossiers C:\Users sans référence registre ProfileList

$UserFolders = Get-ChildItem "$env:SystemDrive\Users" -Directory -Force -ErrorAction SilentlyContinue

$ProfilePathsFromRegistry = $AllProfiles.Path | ForEach-Object {
    $_.TrimEnd('\')
}

$OrphanUserFolders = $UserFolders | Where-Object {
    $_.FullName.TrimEnd('\') -notin $ProfilePathsFromRegistry
}

$DomainProfiles  = $AllProfiles | Where-Object { $_.AccountType -eq "DOMAIN" }
$CloudProfiles   = $AllProfiles | Where-Object { $_.AccountType -eq "CLOUD" }
$LocalProfiles   = $AllProfiles | Where-Object { $_.AccountType -eq "LOCAL" }
$SystemProfiles  = $AllProfiles | Where-Object { $_.AccountType -eq "SYSTEM" }
$UnknownProfiles = $AllProfiles | Where-Object { $_.AccountType -eq "UNKNOWN" }


Write-Log "********************************************** PROFILS WINDOWS avec CimINSTANCE **********************************************"
Write-Log "Nombre total de profils détectés : $(($AllProfiles | Measure-Object).Count)"

Write-Log ""
Write-Log "--------------------------- PROFILS DOMAINE -------------------------------------------------"
Write-Log "Nombre de profils domaine détectés : $(($DomainProfiles | Measure-Object).Count)"

foreach ($profile in $DomainProfiles) {
    Write-Log "Profil domaine : User=$($profile.Account) | SID=$($profile.Sid) | Profile=$($profile.ProfileDir) | SizeApproxMB=$($profile.ProfileSizeMB) | Path=$($profile.Path) | LastLoadTime=$(Get-ProfileAgeText -LastLoadTime $profile.LastLoadTime)"
}

Write-Log ""
Write-Log "--------------------------- PROFILS CLOUD / AzureAD -------------------------------------------------"
Write-Log "Nombre de profils cloud détectés : $(($CloudProfiles | Measure-Object).Count)"

foreach ($profile in $CloudProfiles) {
    Write-Log "Profil cloud : User=$($profile.Account) | SID=$($profile.Sid) | Profile=$($profile.ProfileDir) | SizeApproxMB=$($profile.ProfileSizeMB) | Path=$($profile.Path) | LastLoadTime=$(Get-ProfileAgeText -LastLoadTime $profile.LastLoadTime)"
}

Write-Log ""
Write-Log "--------------------------- PROFILS LOCAUX MACHINE -------------------------------------------------"
Write-Log "Nombre de profils locaux machine détectés : $(($LocalProfiles | Measure-Object).Count)"

foreach ($profile in $LocalProfiles) {
    Write-Log "Profil local machine : User=$($profile.Account) | SID=$($profile.Sid) | Profile=$($profile.ProfileDir) | SizeApproxMB=$($profile.ProfileSizeMB) | Path=$($profile.Path) | LastLoadTime=$(Get-ProfileAgeText -LastLoadTime $profile.LastLoadTime)"
}

Write-Log ""
Write-Log "--------------------------- PROFILS SYSTEME EXEMPTES OBLIGATOIRES ------------------------------------------------"
Write-Log "Nombre de profils système détectés : $(($SystemProfiles | Measure-Object).Count)"

foreach ($profile in $SystemProfiles) {
    Write-Log "Profil système : User=$($profile.Account) | SID=$($profile.Sid) | Profile=$($profile.ProfileDir) | SizeApproxMB=$($profile.ProfileSizeMB) | Path=$($profile.Path)"
}

Write-Log ""
Write-Log "--------------------------- PROFILS INCONNUS / NON RESOLUS ------------------------------------------------"
Write-Log "Nombre de profils inconnus détectés : $(($UnknownProfiles | Measure-Object).Count)"

foreach ($profile in $UnknownProfiles) {
    Write-Log "Profil inconnu ignoré : User=$($profile.Account) | SID=$($profile.Sid) | Profile=$($profile.ProfileDir) | SizeApproxMB=$($profile.ProfileSizeMB) | Path=$($profile.Path) | LastLoadTime=$(Get-ProfileAgeText -LastLoadTime $profile.LastLoadTime)" "WARNING"
}

Write-Log ""
Write-Log "--------------------------- PROFILS UTILISATEURS EXEMPTES ------------------------------------------------"

$ExemptProfiles = $AllProfiles | Where-Object {
    Test-ProtectedProfile `
        -ProfileDir $_.ProfileDir `
        -Account $_.Account `
        -ProtectedPatterns $ProtectedProfiles
}

Write-Log "Nombre de profils utilisateurs exemptés : $(($ExemptProfiles | Measure-Object).Count)"

foreach ($profile in $ExemptProfiles) {
    Write-Log "Profil utilisateur exempté : Type=$($profile.AccountType) | User=$($profile.Account) | SID=$($profile.Sid) | Profile=$($profile.ProfileDir) | SizeApproxMB=$($profile.ProfileSizeMB) | Path=$($profile.Path)"
}

Write-Log ""
Write-Log "--------------------------- PROFILS CANDIDATS SUPPRESSION ------------------------------------------------"

$CandidateProfiles = @(
        $DomainProfiles
        $CloudProfiles
        )

    if ($DeleteLocalProfiles) {  $CandidateProfiles += $LocalProfiles }

$ProfilesToDelete = $CandidateProfiles | Where-Object {
    $_.LastLoadTime -and
    $_.LastLoadTime -lt $CutoffDate -and
    -not (Test-ProtectedProfile `
        -ProfileDir $_.ProfileDir `
        -Account $_.Account `
        -ProtectedPatterns $ProtectedProfiles)
}

Write-Log "Nombre de profils candidats suppression : $(($ProfilesToDelete | Measure-Object).Count)"

foreach ($profile in $ProfilesToDelete) {
    Write-Log "Candidat suppression : Type=$($profile.AccountType) | User=$($profile.Account) | SID=$($profile.Sid) | Profile=$($profile.ProfileDir) | SizeApproxMB=$($profile.ProfileSizeMB) | Path=$($profile.Path) | LastLoadTime=$(Get-ProfileAgeText -LastLoadTime $profile.LastLoadTime)"
}


# BLOC4 -------------------------------------- NETTOYAGE PROFIL UTILISATEUR AVEC WIN32_USERPROFILE --------------------------------------------------------------------------------------------------------------------------------------------------------

$DeletedCount = 0
$SkippedCount = 0
$ErrorCount   = 0
Write-Log ""

if (-not $ProfilesToDelete -or ($ProfilesToDelete | Measure-Object).Count -eq 0) {
    Write-Log "Aucun profil éligible à la suppression - Remove-CimInstance non exécuté" "WARNING"
}
else {
    if ($SimulationMode) {
        Write-Log "********************* SIMULATION *****************************" "WARNING"
    }
    else {
        Write-Log "********************* EFFACEMENT *****************************" "INFO"
    }

    try {
        $CimProfiles = Get-CimInstance Win32_UserProfile -ErrorAction Stop
    }
    catch {
        Write-Log "Impossible de récupérer Win32_UserProfile : $($_.Exception.Message)" "ERROR"
        exit 1
    }

    $CimProfilesBySid = @{}

    foreach ($cim in $CimProfiles) {
        if ($cim.SID -and -not $CimProfilesBySid.ContainsKey($cim.SID)) {
            $CimProfilesBySid[$cim.SID] = $cim
        }
    }
# ----------------------------------------------------------START des gardes-fous -------------------------------

    #on analyse et on met les gardes-fous
    foreach ($profile in $ProfilesToDelete) {
        
        if ($profile.Sid -notmatch '^S-1-5-21-.+-\d+$') {
            Write-Log "Profil ignoré - SID non utilisateur standard : User=$($profile.Account) | SID=$($profile.Sid) | Path=$($profile.Path)" "WARNING"
            $SkippedCount++
            continue      }

        if (-not $CimProfilesBySid.ContainsKey($profile.Sid)) {
            Write-Log "Profil CIM introuvable : User=$($profile.Account) | SID=$($profile.Sid) | Path=$($profile.Path)" "WARNING"
            $SkippedCount++
            continue      }

        $cimProfile = $CimProfilesBySid[$profile.Sid]

        if ($cimProfile.Special) {
            Write-Log "Profil spécial ignoré : User=$($profile.Account) | SID=$($profile.Sid) | Path=$($profile.Path)" "WARNING"
            $SkippedCount++
            continue      }


        if ($profile.Path -notlike "$env:SystemDrive\Users\*") {
            Write-Log "Profil hors chemin standard ignoré : User=$($profile.Account) | SID=$($profile.Sid) | Path=$($profile.Path)" "WARNING"
            $SkippedCount++
            continue      }

        if ($cimProfile.Loaded) {
            Write-Log "Profil chargé/en cours d'utilisation ignoré : User=$($profile.Account) | SID=$($profile.Sid) | Path=$($profile.Path)" "WARNING"
            $SkippedCount++
            continue      }

        if ($SimulationMode) {
            Write-Log "SIMULATION - Profil qui serait supprimé : Type=$($profile.AccountType) | User=$($profile.Account) | SID=$($profile.Sid) | Path=$($profile.Path)"
            $SkippedCount++
            continue        }
# ----------------------------------------------------------END des gardes-fous -------------------------------
        #si aucun garde fou n'arrête -> GO pour la suppression

        try {
            Write-Log ""
            Write-Log "Début nettoyage : $profile"
            Remove-CimInstance -InputObject $cimProfile -ErrorAction Stop -WarningAction SilentlyContinue
            Write-Log "Profil supprimé via Win32_UserProfile : Type=$($profile.AccountType) | User=$($profile.Account) | SID=$($profile.Sid) | Path=$($profile.Path)"
            $DeletedCount++
        }
        catch {
            Write-Log "Erreur suppression profil CIM : Type=$($profile.AccountType) | User=$($profile.Account) | SID=$($profile.Sid) | Path=$($profile.Path) | $($_.Exception.Message)" "ERROR"
            $ErrorCount++
        }
          Write-Log ""
    }
  
    Write-Log "Résumé nettoyage profils : Supprimés=$DeletedCount | Ignorés=$SkippedCount | Erreurs=$ErrorCount"
}


# BLOC5 -------------------------------------- NETTOYAGE PROFIL ORPHELIN AVEC REMOVE-ITEM ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

Write-Log ""
Write-Log "********************************************** DOSSIERS C:\USERS ORPHELINS avec Remove-Item **********************************************"
Write-Log "Nombre de dossiers C:\Users sans référence registre : $(($OrphanUserFolders | Measure-Object).Count)"
Write-Log "Nettoyage dossiers orphelins activé : $CleanOrphanProfiles"
Write-Log ""

if ($SimulationMode) {
    Write-Log "********************* SIMULATION *****************************" "WARNING"
}
else {
    Write-Log "********************* EFFACEMENT *****************************" "INFO"
}

Write-Log "Patterns dossiers orphelins protégés : $($ProtectedOrphanFolders -join ', ')"

$OrphanDeletedCount   = 0
$OrphanSimulatedCount = 0
$OrphanExemptedCount  = 0
$OrphanDetectedCount  = 0
$OrphanErrorCount     = 0

foreach ($folder in $OrphanUserFolders) {

    # Protection reparse point / junction / symlink
    if ($folder.Attributes -band [System.IO.FileAttributes]::ReparsePoint) {
        Write-Log "Dossier orphelin ignoré - reparse point/junction/symlink : Folder=$($folder.Name)  | SizeApproxMB=$folderSizeMB | Path=$($folder.FullName) | Path=$($folder.FullName)" "INFO"
        $OrphanExemptedCount++
        continue    }

    # Protection chemin parent inattendu
    if ((Split-Path -Path $folder.FullName -Parent) -ne "$env:SystemDrive\Users") {
        Write-Log "Dossier orphelin ignoré - parent inattendu : Folder=$($folder.Name) | Path=$($folder.FullName) | SizeApproxMB=$folderSizeMB | Path=$($folder.FullName) " "WARNING"
        $OrphanExemptedCount++
        continue   }

    if ($CalculateProfileSize) {
        $folderSizeMB = Get-ProfileSizeMB `
            -Path $folder.FullName `
            -MaxSeconds $MaxSeconds  }

    else { $folderSizeMB = $null  }

    $isProtectedOrphan = Test-ProtectedOrphanFolder `
        -FolderName $folder.Name `
        -ProtectedPatterns $ProtectedOrphanFolders

    if ($isProtectedOrphan) {
        Write-Log "Dossier orphelin exempté : Folder=$($folder.Name) | SizeApproxMB=$folderSizeMB | Path=$($folder.FullName)" "INFO"
        $OrphanExemptedCount++
        continue   }

    if (-not $CleanOrphanProfiles) {
        Write-Log "Dossier orphelin détecté - fonction clean Orphan désactivée : Folder=$($folder.Name) | SizeApproxMB=$folderSizeMB | Path=$($folder.FullName) | LastWriteTime=$($folder.LastWriteTime.ToString("yyyy-MM-dd HH:mm:ss"))" "INFO"
        $OrphanDetectedCount++
        continue   }

    if ($SimulationMode) {
        Write-Log "SIMULATION - Dossier orphelin qui serait supprimé : Folder=$($folder.Name) | SizeApproxMB=$folderSizeMB | Path=$($folder.FullName)" "INFO"
        $OrphanSimulatedCount++
        continue   }

    try {
        Write-Log "Suppression dossier orphelin : Folder=$($folder.Name) | SizeApproxMB=$folderSizeMB | Path=$($folder.FullName)" "WARNING"

        Remove-Item -LiteralPath $folder.FullName -Recurse -Force -ErrorAction Stop

        Write-Log "Dossier orphelin supprimé : Folder=$($folder.Name) | Path=$($folder.FullName)"
        $OrphanDeletedCount++    }

    catch {
        Write-Log "Erreur suppression dossier orphelin : Folder=$($folder.Name) | Path=$($folder.FullName) | $($_.Exception.Message)" "ERROR"
        $OrphanErrorCount++
    } }

if ($SimulationMode -and $CleanOrphanProfiles) {    Write-Log "SIMULATION - Résumé dossiers orphelins : Suppressions simulées=$OrphanSimulatedCount | Exemptés=$OrphanExemptedCount | Erreurs=$OrphanErrorCount" "WARNING"}

else {    Write-Log "Résumé dossiers orphelins : Détectés=$OrphanDetectedCount | Supprimés=$OrphanDeletedCount | Exemptés=$OrphanExemptedCount | Erreurs=$OrphanErrorCount"}

# BLOC6 -------------------------------------- Fin  ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
Write-Log "------------------------------------------------------------------------------------------------------------------ END script + logging ------------------------------------------------------------------------------------------------------------------"

if (($ErrorCount -gt 0) -or ($OrphanErrorCount -gt 0)) {
    exit 1
}

exit 0
