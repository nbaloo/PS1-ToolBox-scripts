 # QD - Recherche fichiers PST sur C:
# ====================================================================
  
$Resultats = Get-ChildItem -Path "\hfr.ch\files\Prive\ErardV" -Filter "*.pst" -Recurse -Force -ErrorAction SilentlyContinue |
Select-Object FullName,
              @{Name="TailleGB";Expression={[Math]::Round($_.Length / 1GB,2)}},
              LastWriteTime
  
if ($Resultats) {
    $Resultats | Format-Table -AutoSize
}
else {
    Write-Host "Aucun fichier PST trouvé."
}
 

